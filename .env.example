# ===== 数据库（PostgreSQL 16 + PostGIS 3.4） =====
POSTGRES_DB=mydbd
DB_USER=mydbd
DB_PASSWORD=change_me_in_prod

# ===== JWT 与服务令牌（生产请用 openssl rand -hex 32 生成） =====
JWT_HMAC_SECRET=change_me_to_32_bytes_min_length_secret_value_here
SERVICE_TOKEN=change_me_service_token_for_internal_api_calls

# ===== Java 应用 =====
JAVA_OPTS=-Xmx640m -XX:+UseG1GC

# ===== 高德地图（逆地理编码 / 地点检索，控制台 https://console.amap.com 申请 Web服务 Key） =====
AMAP_KEY=

# ===== vps 车载网关对接 =====
# 运行模式：simulator=内置模拟器（默认） / mock=仿真数据灌本地Kafka验证 / gateway=对接正式网关
GATEWAY_MODE=simulator
# Kafka 地址：mock 模式填 kafka:9092（先 docker compose --profile dev-infra up -d）；
# gateway 模式填网关集群 broker 列表，逗号分隔
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP_ID=mydbd-ingest
# 网关附件服务地址（18009，用于转存图片/音视频），留空则不转存
GATEWAY_FILE_BASE_URL=
# 附件策略：local=转存平台卷 / proxy=仅记录原始URL
GATEWAY_MEDIA_STRATEGY=local
